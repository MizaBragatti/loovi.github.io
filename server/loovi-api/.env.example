# Banco de dados
DATABASE_URL=postgresql://user:password@localhost:5432/loovi_api?schema=public

# Servidor
PORT=3000

# API da Loovi (mesmo backend usado pelo portal escritoriovirtual.loovi.com.br)
LOOVI_BASE_URL=https://api-gateway.loovi.app.br
# Token JWT obtido via login OTP (SSO) do executivo/vendedor; expira em ~1h,
# precisa ser trocado manualmente quando expirar.
LOOVI_API_KEY=changeme
# Código do vendedor (slp), vem do claim "slp" do token acima.
LOOVI_SLP=changeme

# Emissor do SSO da Loovi - usado para validar (via JWKS) o Bearer token
# enviado por quem chama nossa API (o mesmo token de sessão do portal).
LOOVI_SSO_ISSUER=https://sso.loovi.app.br
